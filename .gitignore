# =====================================================================
#  데이터 — 절대 커밋 금지 (원본만 13.5GB)
# =====================================================================
data/raw/*
!data/raw/.gitkeep
!data/raw/*/
data/raw/*/*
!data/raw/*/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/interim/
data/external/

# 단, 아래는 반드시 추적합니다 (작고, 재현의 핵심)
#   data/splits/   : 어느 시퀀스가 train/val/test로 갔는지
#   data/reports/  : 검증 리포트 JSON

# 대용량 확장자 (경로 무관 방어선)
*.tar
*.tar.gz
*.zip
*.7z
*.mov
*.mp4
*.avi
*.mkv
*.parquet

# =====================================================================
#  모델 가중치 — 커밋 금지
#   사전학습(yolo11n.pt)은 Ultralytics가 자동 다운로드합니다.
#   학습 결과(best.pt)는 Google Drive에 두고 README에 링크만 남깁니다.
# =====================================================================
*.pt
*.pth
*.onnx
*.engine
*.trt
*.plan

# 단, 모델 "구조 정의"인 yaml은 반드시 추적 (configs/model/*.yaml)

# =====================================================================
#  학습 산출물
#   runs/ 는 통째로 제외하고, 공유할 결과는 docs/experiments/ 로 복사
# =====================================================================
runs/*
!runs/.gitkeep
wandb/
lightning_logs/
*.log

# =====================================================================
#  Python
# =====================================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =====================================================================
#  환경 / 비밀
# =====================================================================
.env
.env.*
*.key
credentials.json
service_account*.json

# =====================================================================
#  OS / 에디터
# =====================================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
